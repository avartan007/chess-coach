# Copy this file to .env and update values before running the backend.
# Path to your Stockfish binary. Example macOS Homebrew install path:
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
# Comma-separated allowed origins for CORS (use your frontend URL in production)
ALLOWED_ORIGINS=http://localhost:5174
# Optional: override the API URL used by the frontend when building
# VITE_API_URL=https://your-backend.example.com
# ─────────────────────────────────────────────────────────────────────────────
# Chess Coach OS — Environment Configuration
# Copy this file to `.env` in the same directory and customize the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server Configuration ──
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development  # 'development' or 'production'

# ── Stockfish Binary Path ──
# Update this to point to the exact location of your Stockfish executable.
# 
# Common OS Defaults:
# - macOS (Homebrew):  /opt/homebrew/bin/stockfish
# - Linux (apt):       /usr/games/stockfish
# - Windows (direct):  C:/stockfish/stockfish.exe
STOCKFISH_PATH=/opt/homebrew/bin/stockfish

# ── CORS Settings ──
# Comma-separated list of allowed origins. Use '*' for open development.
ALLOWED_ORIGINS=*
